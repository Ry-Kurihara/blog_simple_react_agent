# Fishing MCP - Streamable HTTP Transport設定例

# Transport モード（streamable-http、stdio、sse）
MCP_TRANSPORT=streamable-http

# サーバーのホストとポート
MCP_HOST=0.0.0.0
MCP_PORT=5555

# Basic認証（オプション）
# 設定した場合、すべてのリクエストでBasic認証が必要になります
MCP_BASIC_AUTH_USER=fishing_user
MCP_BASIC_AUTH_PASS=your_secure_password_here

# Python パス（通常は不要ですが、環境によっては設定が必要）
# PYTHONPATH=/path/to/your/project
