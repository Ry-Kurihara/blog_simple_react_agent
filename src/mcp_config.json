{
  "mcpServers": {
    "playwright": {
      "transport": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "mcp/playwright"
      ]
    },
    "chrome-devtools": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--headless=true",
        "--isolated=true"
      ]
    },
    "fishing_mcp": {
      "transport": "stdio",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "server.fishing_mcp.src.server"
      ]
    }
  }
}
